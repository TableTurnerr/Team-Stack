DISCORD_BOT_TOKEN=           # From Discord Developer Portal → Bot tab

POCKETBASE_URL=              # e.g. https://your-pb-instance.com
POCKETBASE_ADMIN_EMAIL=      # PocketBase admin email
POCKETBASE_ADMIN_PASSWORD=   # PocketBase admin password

POLL_INTERVAL_MINUTES=5      # Cron interval for follow-up checks (default 5)

CRM_BASE_URL=                # e.g. https://crm.tableturnerr.com (for "Open in CRM" links)

# ── Central telemetry (uptime heartbeat + centralized logs) ──
# Ships a heartbeat + structured logs to the parent-site ingest API so this bot
# shows up on the admin Status/Logs dashboard. Leave unset to disable (the bot
# runs fine without it). TELEMETRY_TOKEN is a server-side secret.
TELEMETRY_URL=https://tableturnerr.com
TELEMETRY_TOKEN=
SERVICE_KEY=discord-bot
