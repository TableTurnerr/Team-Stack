# CRM-Tableturnerr Environment Variables
# This file documents all environment variables used across services.
# Each service has its own .env file - this is for reference only.

# =============================================================================
# ARCHITECTURE
# =============================================================================
# PocketBase API  → Ubuntu server via Cloudflare Tunnel → crmdb.tableturnerr.com
# Dashboard       → Vercel                              → app.yourdomain.com
# =============================================================================

# -----------------------------------------------------------------------------
# PocketBase Configuration (used by: transcriber, database tools)
# -----------------------------------------------------------------------------
# Development (local network):
# POCKETBASE_URL=http://192.168.x.x:8090
#
# Production (via Cloudflare Tunnel):
# POCKETBASE_URL=http://crmdb.tableturnerr.com

POCKETBASE_URL=http://crmdb.tableturnerr.com
PB_ADMIN_EMAIL=your_admin_email@example.com
PB_ADMIN_PASSWORD=your_admin_password

# -----------------------------------------------------------------------------
# Dashboard Configuration (used by: apps/dashboard)
# -----------------------------------------------------------------------------
# This is exposed to the browser, so use the public API URL
# Development: http://localhost:8090
# Production:  http://crmdb.tableturnerr.com

NEXT_PUBLIC_POCKETBASE_URL=http://crmdb.tableturnerr.com

# -----------------------------------------------------------------------------
# Supabase (reserved for future migration — see POCKETBASE-TO-SUPABASE-MIGRATION.md)
# -----------------------------------------------------------------------------
# The dashboard currently runs entirely on PocketBase. These vars are documented
# for the in-progress migration; leave blank unless working on that track.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Gemini API (used by: transcriber)
# -----------------------------------------------------------------------------
# Get your API key from: https://makersuite.google.com/app/apikey

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Google OAuth (optional - can configure in PocketBase Admin UI instead)
# -----------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=your_client_id
# GOOGLE_CLIENT_SECRET=your_client_secret

# -----------------------------------------------------------------------------
# Web Push / PWA follow-up notifications (used by: apps/dashboard)
# -----------------------------------------------------------------------------
# Generate VAPID keys once: node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
# NEXT_PUBLIC_VAPID_PUBLIC_KEY must equal VAPID_PUBLIC_KEY (it's exposed to browser).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret for Vercel Cron → /api/cron/push-followups
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# -----------------------------------------------------------------------------
# GoHighLevel Integration (used by: apps/dashboard /api/ghl/* + Lead Scraper ext)
# -----------------------------------------------------------------------------
# Marketplace app (SUB-ACCOUNT / Location-level install). Create the app at
# https://marketplace.gohighlevel.com (distribution type: Sub-Account) and add
# the redirect URL below. Each install authorizes one sub-account; the OAuth
# token is scoped to that location.
# Scopes to enable: locations.readonly locations/tags.readonly
#                   locations/tags.write contacts.readonly contacts.write
#                   opportunities.readonly opportunities.write users.readonly
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
# Must exactly match a redirect URL registered on the Marketplace app:
GHL_REDIRECT_URI=https://crm.tableturnerr.com/api/hl/oauth/callback
# Optional: secret used to sign the OAuth `state` value. Falls back to
# GHL_CLIENT_SECRET if unset. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GHL_STATE_SECRET=

# Shared-location GHL dashboard integration (server-only).
# This is intentionally separate from the extension's per-user OAuth connection.
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=
GHL_DEFAULT_LEAD_SOURCE=Tableturnerr Dashboard
GHL_LEAD_CUSTOM_FIELD_KEYS=
GHL_STALE_DAYS=14
GHL_REQUEST_TIMEOUT_MS=12000

# HubSpot Integration Configuration
# Copy this file to .env and fill in your values

# HubSpot Private App Access Token
# Get this from: HubSpot > Settings > Integrations > Private Apps
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# PocketBase URL (for future migration scripts)
POCKETBASE_URL=http://127.0.0.1:8090
