# Copy to `.env` (gitignored) and fill in. The self-hosted bridge loads `.env`
# at startup via process.loadEnvFile(); on the deploy box you can inject these
# as real environment variables instead.

# ── Zoom Server-to-Server OAuth app ──
ZOOM_SECRET_TOKEN=
ZOOM_VERIFICATION_TOKEN=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_ACCOUNT_ID=

# ── GHL Marketplace app ──
GHL_MARKETPLACE_CLIENT_ID=
GHL_MARKETPLACE_CLIENT_SECRET=
GHL_MARKETPLACE_CONVERSATION_PROVIDER_ID=
GHL_LOCATION_ID=

# Shared bearer token the CRM agents present on POST /recordings/ingest.
AGENT_SHARED_TOKEN=

# Public https origin this bridge is reached at (no trailing slash). Used to
# build the GHL OAuth redirect_uri; must match the Redirect URI registered in
# the GHL Marketplace app exactly. Required behind the Cloudflare Tunnel, where
# the internal hop is plain HTTP and the scheme would otherwise be wrong.
PUBLIC_BASE_URL=https://zoomphone.tableturnerr.com

# ── Server (optional; defaults shown) ──
# PORT=8787
# HOST=127.0.0.1
# BRIDGE_DB_PATH=./data/bridge.db
# Silence node:sqlite's experimental warning in production:
# NODE_OPTIONS=--disable-warning=ExperimentalWarning
