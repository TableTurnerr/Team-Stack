{
  "name": "zoomphone-ghl-bridge",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted Node service that mirrors Zoom Phone call activity into GoHighLevel and ingests local call recordings.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
