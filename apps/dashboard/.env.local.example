# Dashboard Environment Variables
# Copy this file to .env.local for local development
# For Vercel deployment, set these in Vercel's Environment Variables settings

# PocketBase API URL — ACTIVE database for the dashboard (all reads/writes)
# Development: https://localhost:8090
# Production:  https://crmdb.tableturnerr.com
NEXT_PUBLIC_POCKETBASE_URL=https://localhost:8090

# Supabase — reserved for the in-progress PocketBase → Supabase migration
# (see POCKETBASE-TO-SUPABASE-MIGRATION.md at repo root). Not yet wired into
# the dashboard code. Leave blank unless working on the migration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PartnerStack Partner API key
# Find it in your PartnerStack dashboard → Settings → API → Reveal
# Used server-side only (never exposed to the browser)
PARTNERSTACK_API_KEY=

# Gemini API key — used for AI invoice parsing on the financial dashboard
# Get yours at: https://aistudio.google.com/app/apikey
# Used server-side only (never exposed to the browser)
GEMINI_API_KEY=

# Gemini model to use for invoice parsing (server-side only)
# Use standard REST models only — Live/streaming models (e.g. *-live-preview) are NOT supported
# Exact valid model IDs (copy-paste one of these):
#   gemini-2.5-flash      ← default, fast & cheap
GEMINI_MODEL=gemini-2.5-flash

# Zoom Phone Webhook — receives real-time call events from Zoom
# Create a Server-to-Server OAuth app at https://marketplace.zoom.us
# Set webhook endpoint URL to: https://your-domain.com/api/zoom/webhook
# Copy the "Secret Token" from your Zoom app's webhook settings
ZOOM_WEBHOOK_SECRET_TOKEN=

# PocketBase admin credentials — used server-side to store Zoom webhook events,
# push subscriptions, and to run the follow-up push cron
# These are your PocketBase superuser credentials (not a regular user)
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# Web Push / PWA follow-up notifications
# Generate a VAPID key pair (one time) with:
#   node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
# - VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY: signed by the server when sending pushes
# - NEXT_PUBLIC_VAPID_PUBLIC_KEY: same value as VAPID_PUBLIC_KEY, exposed to the
#   browser so the service worker can subscribe
# - VAPID_SUBJECT: mailto: URI the push services use to reach you about abuse
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Upstash QStash — delivers follow-up push notifications at scheduled_time.
# Replaces the old Vercel cron. Sign up at https://console.upstash.com/qstash
# - QSTASH_TOKEN: publisher token (Request Builder → Token)
# - QSTASH_CURRENT_SIGNING_KEY / QSTASH_NEXT_SIGNING_KEY: used to verify
#   incoming QStash callbacks on /api/qstash/push-followup
# - PUBLIC_APP_URL: public origin QStash should call back into
#   (on Vercel, VERCEL_URL is used automatically if this is unset)
# QSTASH_URL: region base URL (leave blank for US; EU accounts need
#   https://qstash-eu-central-1.upstash.io)
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
PUBLIC_APP_URL=
