# Insta Outreach Agent Environment Variables
# Copy this file to .env and fill in your values

POCKETBASE_URL=http://localhost:8090
PB_ADMIN_EMAIL=your_admin_email@example.com
PB_ADMIN_PASSWORD=your_admin_password

# ── Central telemetry (uptime heartbeat + centralized logs) ──
# Ships a heartbeat + log records to the parent-site ingest API so this agent
# appears on the admin Status/Logs dashboard. Leave unset to disable.
# TELEMETRY_TOKEN is a server-side secret; never commit a real value.
TELEMETRY_URL=https://tableturnerr.com
TELEMETRY_TOKEN=
SERVICE_KEY=insta-outreach-agent
