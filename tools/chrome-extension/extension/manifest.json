{
  "manifest_version": 3,
  "name": "TableTurner Lead Scraper",
  "version": "5.4",
  "description": "TableTurner Lead Scraper - Chrome extension for lead generation with GoHighLevel integration",
  "key": "",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "unlimitedStorage",
    "notifications",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://www.google.com/maps/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps/*"
      ],
      "js": [
        "manual_mode_maps.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.gohighlevel.com/*",
        "https://*.leadconnectorhq.com/*",
        "https://ghl.tableturnerr.com/*"
      ],
      "js": [
        "ghl_enhancements.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.zoom.us/*",
        "https://pwa.zoom.us/*",
        "https://*.zoom.us/*"
      ],
      "js": [
        "zoom_call_detect_main.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://app.zoom.us/*",
        "https://pwa.zoom.us/*",
        "https://*.zoom.us/*"
      ],
      "js": [
        "zoom_call_detect.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "commands": {
    "scrape": {
      "suggested_key": {
        "default": "Ctrl+Shift+S"
      },
      "description": "Scrape Google Maps from active tab"
    },
    "toggle_manual_overlay": {
      "suggested_key": {
        "default": "Ctrl+Shift+M"
      },
      "description": "Toggle manual mode overlay"
    },
    "manual_add_to_list": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Add current item to list (Manual Mode)"
    },
    "open_website": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Open business website (Manual Mode)"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
