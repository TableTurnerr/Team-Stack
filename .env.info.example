# CRM-Tableturnerr Environment Variables
# This file documents all environment variables used across services.
# Each service has its own .env file - this is for reference only.

# =============================================================================
# ARCHITECTURE
# =============================================================================
# PocketBase API  → Ubuntu server via Cloudflare Tunnel → api.yourdomain.com
# Dashboard       → Vercel                              → app.yourdomain.com
# =============================================================================

# -----------------------------------------------------------------------------
# PocketBase Configuration (used by: transcriber, database tools)
# -----------------------------------------------------------------------------
# Development (local network):
# POCKETBASE_URL=http://192.168.x.x:8090
#
# Production (via Cloudflare Tunnel):
# POCKETBASE_URL=https://api.yourdomain.com

POCKETBASE_URL=https://api.yourdomain.com
PB_ADMIN_EMAIL=your_admin_email@example.com
PB_ADMIN_PASSWORD=your_admin_password

# -----------------------------------------------------------------------------
# Dashboard Configuration (used by: apps/dashboard)
# -----------------------------------------------------------------------------
# This is exposed to the browser, so use the public API URL
# Development: http://localhost:8090
# Production:  https://api.yourdomain.com

NEXT_PUBLIC_POCKETBASE_URL=https://api.yourdomain.com

# -----------------------------------------------------------------------------
# Gemini API (used by: transcriber)
# -----------------------------------------------------------------------------
# Get your API key from: https://makersuite.google.com/app/apikey

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Google OAuth (optional - can configure in PocketBase Admin UI instead)
# -----------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=your_client_id
# GOOGLE_CLIENT_SECRET=your_client_secret

# -----------------------------------------------------------------------------
# Web Push / PWA follow-up notifications (used by: apps/dashboard)
# -----------------------------------------------------------------------------
# Generate VAPID keys once: node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
# NEXT_PUBLIC_VAPID_PUBLIC_KEY must equal VAPID_PUBLIC_KEY (it's exposed to browser).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret for Vercel Cron → /api/cron/push-followups
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# HubSpot Integration Configuration
# Copy this file to .env and fill in your values

# HubSpot Private App Access Token
# Get this from: HubSpot > Settings > Integrations > Private Apps
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# PocketBase URL (for future migration scripts)
POCKETBASE_URL=http://127.0.0.1:8090