# ─── Copy this file to .env.test and fill in your values ───────────────────────
# .env.test is NOT committed to git — add it to .gitignore

# ── Dashboard URL ──────────────────────────────────────────────────────────────
# Where the Next.js dev server is running
TEST_BASE_URL=http://localhost:3000

# ── Parallelism ────────────────────────────────────────────────────────────────
# How many Playwright workers to use in parallel (e.g. 1, 4, or '50%')
# Defaults to 50% of CPU cores if not set.
TEST_WORKERS=50%

# ── Test User Credentials ──────────────────────────────────────────────────────
# A regular user account for running UI tests (should have admin role for full coverage)
TEST_USER_EMAIL=your_admin@example.com
TEST_USER_PASSWORD=your_password_here

# ── PocketBase Connection ──────────────────────────────────────────────────────
# Used by the pb-client.ts helper to seed/cleanup test data via API
NEXT_PUBLIC_POCKETBASE_URL=http://localhost:8090
TEST_POCKETBASE_URL=http://localhost:8090

# PocketBase superadmin credentials (needed to bypass collection rules in tests)
TEST_PB_ADMIN_EMAIL=admin@example.com
TEST_PB_ADMIN_PASSWORD=your_pb_admin_password

# ── Live Call Tests (disabled by default) ──────────────────────────────────────
# Set to "true" ONLY when you want to actually place real phone calls.
# Requires Zoom Phone desktop app installed and logged in.
TEST_LIVE_CALLS=false

# How long (seconds) to stay on each test call before hanging up (default: 10)
TEST_CALL_DURATION_SEC=10
